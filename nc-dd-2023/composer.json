{
    "name":              "laravel/laravel",
    "type":              "project",
    "description":       "The Laravel Framework.",
    "keywords":          [
        "framework",
        "laravel"
    ],
    "license":           "MIT",
    "require":           {
        "php":                                  "^8.1.0",
        "ext-soap":                             "*",
        "arquivei/laravel-prometheus-exporter": "^4.0",
        "artisaninweb/laravel-soap":            "0.3.0.10",
        "centrifugal/phpcent":                  "~5.0",
        "doctrine/dbal":                        "^3.0",
        "firebase/php-jwt":                     "^6.4",
        "giggsey/libphonenumber-for-php":       "^8.13",
        "guzzlehttp/guzzle":                    "^7.4",
        "irazasyed/telegram-bot-sdk":           "^3.9",
        "mongodb/laravel-mongodb":              "4.0.0-rc1",
        "laravel/framework":                    "^10.0",
        "laravel/horizon":                      "^5.9",
        "laravel/sanctum":                      "^3.2",
        "laravel/socialite":                    "^5.5",
        "laravel/tinker":                       "^2.7",
        "laravelcollective/html":               "^6.3",
        "league/flysystem-aws-s3-v3":           "^3.12",
        "mcamara/laravel-localization":         "^1.7",
        "phpoffice/phpspreadsheet":             "^1.23",
        "predis/predis":                        "^1.1",
        "sentry/sentry-laravel":                "^3.6.1",
        "spatie/laravel-medialibrary":          "^10.3",
        "spatie/laravel-permission":            "^5.5",
        "spatie/laravel-translatable":          "^6.0",
        "voku/simple_html_dom":                 "^4.8",
        "hedii/laravel-gelf-logger":            "^8.1.1"
    },
    "require-dev":       {
        "barryvdh/laravel-debugbar":             "^3.5.2",
        "brianium/paratest":                     "^7.2.2",
        "spatie/laravel-ignition":               "^2.0",
        "fakerphp/faker":                        "^1.9.1",
        "jasonmccreary/laravel-test-assertions": "^2.1",
        "laravel/envoy":                         "^2.7",
        "laravel/sail":                          "^1.0.1",
        "mockery/mockery":                       "^1.4.4",
        "nunomaduro/collision":                  "^7.0",
        "phpunit/phpunit":                       "^10.0"
    },
    "config":            {
        "optimize-autoloader": true,
        "preferred-install":   "dist",
        "sort-packages":       true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra":             {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload":          {
        "psr-4": {
            "App\\":                 "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\":   "database/seeders/"
        }
    },
    "autoload-dev":      {
        "psr-4": {
            "Tests\\":   "tests/",
            "Helpers\\": "tests/Helpers/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable":     true,
    "scripts":           {
        "post-autoload-dump":        [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [],
        "post-create-project-cmd":   [
            "@php artisan key:generate --ansi"
        ]
    }
}
