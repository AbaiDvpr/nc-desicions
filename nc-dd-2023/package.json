{
    "private": true,
    "scripts": {
        "dev:admin": "npm run development --application=admin",
        "dev:site": "npm run development --application=site",
        "dev:cabinet": "npm run development --application=cabinet",
        "dev:all": "npm run development --application=all",
        "development": "mix",
        "watch:admin": "npm run watch --application=admin",
        "watch:site": "npm run watch --application=site",
        "watch:cabinet": "npm run watch --application=cabinet",
        "watch:all": "npm run watch --application=all",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod:admin": "npm run production --application=admin",
        "prod:site": "npm run production --application=site",
        "prod:cabinet": "rm -rf public/static/frontend/cabinet/chunks && npm run production --application=cabinet",
        "prod:all": "rm -rf public/static/frontend/cabinet/chunks && npm run production --application=all",
        "production": "mix --production"
    },
    "devDependencies": {
        "autoprefixer": "10.4.5",
        "laravel-mix": "^6.0.49",
        "laravel-mix-merge-manifest": "^2.1.0",
        "postcss": "^8.1.14",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.56.2",
        "sass-loader": "^13.2.0",
        "sass-resources-loader": "^2.2.5",
        "vue-loader": "^17.0.1",
        "vue-template-compiler": "^2.6.12"
    },
    "dependencies": {
        "@coders-tm/vue-number-format": "^3.27.0",
        "@coreui/coreui": "^3.2.2",
        "@coreui/icons": "^1.0.1",
        "@fullcalendar/core": "^6.1.9",
        "@fullcalendar/daygrid": "^6.1.9",
        "@fullcalendar/interaction": "^6.1.9",
        "@fullcalendar/list": "^6.1.9",
        "@fullcalendar/timegrid": "^6.1.9",
        "@fullcalendar/vue3": "^6.1.9",
        "@popperjs/core": "^2.1.0",
        "@sentry/tracing": "^7.26.0",
        "@sentry/vue": "^7.26.0",
        "apexcharts": "^3.40.0",
        "axios": "^1.2.1",
        "centrifuge": "^3.1.1",
        "chart.js": "^4.2.1",
        "dayjs": "^1.11.7",
        "inputmask": "^5.0.5",
        "jquery": "^3.5.1",
